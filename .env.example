# ============================================================
# 六 AI 圆桌辩论 · 服务端环境变量模板
# 用法：复制本文件为 .env，填入你自己的密钥；.env 不会进入 Git。
# 前端「接入配置」页面填写的密钥优先于本文件；两者二选一即可。
# 留空的 AI 不会参与讨论。
# ============================================================

# 服务端口（可选，默认 3210）
PORT=3210

# 1. ChatGPT（OpenAI）
OPENAI_API_KEY=

# 2. Claude（Anthropic）
ANTHROPIC_API_KEY=

# 3. Codex（默认走 OpenAI 兼容端点；未单独填时复用 OPENAI_API_KEY）
CODEX_API_KEY=

# 4. DeepSeek（深度求索）
DEEPSEEK_API_KEY=

# 5. Gemini（Google 生成式语言）
GEMINI_API_KEY=

# 6. 豆包（火山引擎方舟）
DOUBAO_API_KEY=
# 模型名或在线推理接入点 ID（可选）。方舟需填控制台「在线推理」里状态健康的接入点 ID。
DOUBAO_MODEL=
